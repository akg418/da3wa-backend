# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
# The server validates every variable at boot and refuses to start with a
# message naming each one that is missing or malformed.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000
# Every API route is served under this prefix. Must start with "/".
API_PREFIX=/api/v1

# --- MongoDB ---------------------------------------------------------------
# Pick ONE.
#
# 1. Local MongoDB Community (see the README for the install command)
MONGODB_URI=mongodb://127.0.0.1:27017/invitations
#
# 2. Throwaway in-process MongoDB. No install needed, but all data is lost when
#    the server stops. Development and tests only; refused in production.
# MONGODB_URI=memory
#
# 3. MongoDB Atlas
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- JWT -------------------------------------------------------------------
# Signing key for access tokens. Minimum 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=<min-32-char-random-string>
# Access token lifetime. Format: <number><s|m|h|d>, e.g. 30m, 1h, 7d.
JWT_EXPIRES_IN=1h

# --- Cookies ---------------------------------------------------------------
# Authentication is bearer-token based and sets NO session cookie. These two
# settings apply only to the short-lived, signed `oauth_state` cookie that
# protects the Google authorization-code flow against CSRF.
#
# Set COOKIE_SECURE=true once you serve the API over HTTPS.
COOKIE_SECURE=false
# Keep this "lax". "strict" stops the browser from sending the state cookie
# when Google redirects back, which breaks Google sign-in.
COOKIE_SAME_SITE=lax

# --- API documentation -----------------------------------------------------
# Serves Swagger UI at /docs, plus /docs/json and /docs/yaml.
# Set to false to return 404 there (e.g. in production).
SWAGGER_ENABLED=true

# --- Google OAuth 2.0 ------------------------------------------------------
# From https://console.cloud.google.com/ -> Credentials -> OAuth client ID
# -> Web application. Only needed for the /auth/google routes; username and
# password sign-in works without them.
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
# Must be listed VERBATIM under "Authorized redirect URIs" in Google Console.
# Use `localhost`, not `127.0.0.1` — Google treats them as different origins.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# --- Frontend --------------------------------------------------------------
# Origin of your web client. This is also the CORS allow-list: requests from
# any other origin are rejected by the browser.
FRONTEND_URL=http://localhost:5173
# Path the Google callback redirects to. The access token arrives in the URL
# fragment: <FRONTEND_URL><FRONTEND_AUTH_CALLBACK_PATH>#access_token=...
FRONTEND_AUTH_CALLBACK_PATH=/auth/callback
